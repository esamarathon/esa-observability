# Host ports exposed by the stack. Copy to `.env` to override.

# OTel Collector (OTLP gateway) — apps send telemetry here
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Storage backends
VICTORIAMETRICS_PORT=8428
VICTORIALOGS_PORT=9428
VICTORIATRACES_PORT=10428

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
